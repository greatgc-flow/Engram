{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engram finalized guest result version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handle_id",
    "execution_id",
    "complete",
    "outcome",
    "exit_code",
    "log_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "handle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "complete": {
      "type": "boolean",
      "const": true
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "timed-out",
        "cancelled"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "log_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Relative file paths within this execution directory; containment and existence are validated by the collector."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "type": "integer",
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "type": "integer",
            "not": {
              "const": 0
            }
          }
        }
      }
    }
  ]
}
