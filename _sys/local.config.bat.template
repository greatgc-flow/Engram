@echo off
:: ================================================================
:: local.config.bat  -  Per-PC Configuration
::
:: Copy this template to local.config.bat to add custom overrides.
:: ================================================================

:: HOW TO USE:
::   1. Copy this file -> rename to "local.config.bat" (same folder)
::   2. Uncomment and edit the settings for this PC
::   3. engram.cmd's Python launcher (_sys/core/launcher.py) reads this
::      file's `set "KEY=VALUE"` lines automatically on every `engram
::      launch`/`engram start` -- as plain text data, not by executing it,
::      so only the 2 keys documented below are ever recognized. No manual
::      sourcing needed.
::
:: This file is PC-specific - do NOT copy to other machines via USB.
:: If using git: add _sys\local.config.bat to .gitignore.

:: -- Default workspace --
:: Open a different default folder instead of workspace\
:: set "BASE_DIR_WORKSPACE=D:\Projects\MyWork"

:: -- Custom tool paths --
:: Use system-installed npm instead of portable
:: set "NPM_CONFIG_PREFIX=%APPDATA%\npm"
