{
    "_version": "2.0",
    "_comment": "Pipeline orchestration. 'pipelines' maps CLI commands to ordered operation lists. 'operations' maps op IDs to module+method+failure policy.",
    "operations": {
        "provision.deploy": {
            "module": "core.provisioner",
            "method": "deploy",
            "failure_policy": "abort"
        },
        "env.commit_install": {
            "module": "core.env_manifest",
            "method": "commit_install",
            "failure_policy": "warn"
        },
        "venv.snapshot": {
            "module": "core.venv_manager",
            "method": "snapshot_op",
            "failure_policy": "warn"
        },
        "backups.snapshots": {
            "module": "core.backups",
            "method": "snapshots_main",
            "failure_policy": "abort"
        },
        "repair.run": {
            "module": "core.repair",
            "method": "repair_main",
            "failure_policy": "abort"
        },
        "relocate.run": {
            "module": "core.repair",
            "method": "relocate_main",
            "failure_policy": "abort"
        },
        "registry.apply": {
            "module": "core.registrar",
            "method": "apply",
            "failure_policy": "warn"
        },
        "registry.remove": {
            "module": "core.registrar",
            "method": "remove",
            "failure_policy": "continue"
        },
        "registry.clean_orphans": {
            "module": "core.registrar",
            "method": "clean_orphans",
            "failure_policy": "abort"
        },
        "registry.menu_status": {
            "module": "core.registrar",
            "method": "menu_status",
            "failure_policy": "abort"
        },
        "tidy.run": {
            "module": "core.tidy_temp",
            "method": "run",
            "failure_policy": "abort"
        },
        "env.launch": {
            "module": "core.launcher",
            "method": "main",
            "failure_policy": "abort"
        },
        "update.run": {
            "module": "core.updater",
            "method": "run",
            "failure_policy": "abort"
        },
        "doctor.run": {
            "module": "core.doctor",
            "method": "run",
            "failure_policy": "abort",
            "quiet_failure": true
        },
        "uninstall.run": {
            "module": "core.uninstaller",
            "method": "run",
            "failure_policy": "abort"
        },
        "migration.update_layout": {
            "module": "core.layout_migration",
            "method": "update_layout",
            "failure_policy": "abort"
        },
        "migration.run_layout_migration": {
            "module": "core.layout_migration",
            "method": "run_pipeline",
            "failure_policy": "abort"
        },
        "backup.run": {
            "module": "checks.backup_personal_data",
            "method": "run_backup",
            "failure_policy": "abort"
        },
        "restore.run": {
            "module": "checks.backup_personal_data",
            "method": "run_restore",
            "failure_policy": "abort"
        },
        "reset.run": {
            "module": "checks.backup_personal_data",
            "method": "run_reset",
            "failure_policy": "abort"
        }
    },
    "pipelines": {
        "install": ["provision.deploy", "env.commit_install", "venv.snapshot", "state.write"],
        "menu-enable": [
            "registry.apply",
            "state.write"
        ],
        "menu-disable": [
            "registry.remove",
            "state.prune"
        ],
        "menu-clean": [
            "registry.clean_orphans"
        ],
        "menu-status": [
            "registry.menu_status"
        ],
        "register": [
            "registry.apply",
            "state.write"
        ],
        "unregister": [
            "registry.remove",
            "state.prune"
        ],
        "menu-cleanup": [
            "registry.clean_orphans"
        ],
        "tidy": [
            "tidy.run"
        ],
        "snapshots": ["backups.snapshots"],
        "repair": ["repair.run"],
        "relocate": ["relocate.run"],
        "start": [
            "env.launch"
        ],
        "init": [],
        "update": ["migration.update_layout", "update.run", "venv.snapshot"],
        "doctor": [
            "doctor.run"
        ],
        "uninstall": [
            "uninstall.run"
        ],
        "migrate-layout": [
            "migration.run_layout_migration"
        ],
        "backup": [
            "backup.run"
        ],
        "restore": [
            "restore.run"
        ],
        "reset": [
            "reset.run"
        ]
    }
}