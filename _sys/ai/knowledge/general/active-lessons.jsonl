{"id": "LL-20260703-005", "schema_version": 1, "status": "active", "severity": "critical", "title": "No out-of-band mutation during advisory asks", "compact_rule": "Mutation-capable peers must not modify governed files (orchestration.json, protocol.json, docs, checks) while answering an advisory or debate ask; all governed changes go through consensus and the artifact workflow.", "category": "protocol", "scope": "global", "applies_to": {"peer_ids": ["cc", "ag", "cx"], "os": null, "shell": null, "task_types": null}, "source_refs": [{"type": "user", "id": "manual", "peer": "cc", "ts": "20260703T133357"}], "approval": {"approved_by": "coordinator", "approved_at": "20260703T133525", "record_ref": "approval-log.jsonl"}, "retirement": {"expires_at": null, "superseded_by": null, "review_after": "2026-10-01"}, "enforcement": {"artifact": "enforcement/LL-20260703-005.json"}}
