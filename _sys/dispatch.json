{
    "_version": "2.0",
    "_comment": "Pipeline orchestration. 'pipelines' maps CLI commands to ordered operation lists. 'operations' maps op IDs to module+method+config.",
    "operations": {
        "provision.deploy": {
            "module": "core.provisioner",
            "method": "deploy",
            "config": "runtimes.json",
            "idempotent": true,
            "failure_policy": "abort"
        },
        "registry.apply": {
            "module": "core.registrar",
            "method": "apply",
            "config": "context_menu.json",
            "idempotent": true,
            "failure_policy": "warn",
            "state_key": "register"
        },
        "registry.remove": {
            "module": "core.registrar",
            "method": "remove",
            "idempotent": true,
            "failure_policy": "continue"
        },
        "registry.clean_orphans": {
            "module": "core.registrar",
            "method": "clean_orphans",
            "config": "context_menu.json",
            "idempotent": true,
            "failure_policy": "abort"
        },
        "scrub.run": {
            "module": "core.scrubber",
            "method": "run",
            "idempotent": true,
            "failure_policy": "abort"
        },
        "env.launch": {
            "module": "core.launcher",
            "method": "main",
            "failure_policy": "abort"
        },
        "update.run": {
            "module": "core.updater",
            "method": "run",
            "failure_policy": "abort"
        },
        "status.run": {
            "module": "core.doctor",
            "method": "run",
            "failure_policy": "abort"
        },
        "uninstall.run": {
            "module": "core.uninstaller",
            "method": "run",
            "failure_policy": "abort"
        },
        "migration.run_layout_migration": {
            "module": "core.layout_migration",
            "method": "run_pipeline",
            "idempotent": true,
            "failure_policy": "abort"
        }
    },
    "pipelines": {
        "install": [
            "provision.deploy",
            "state.write"
        ],
        "menu-enable": [
            "registry.apply",
            "state.write"
        ],
        "menu-disable": [
            "registry.remove",
            "state.prune"
        ],
        "menu-clean": [
            "registry.clean_orphans"
        ],
        "register": [
            "registry.apply",
            "state.write"
        ],
        "unregister": [
            "registry.remove",
            "state.prune"
        ],
        "cleanup": [
            "scrub.run"
        ],
        "menu-cleanup": [
            "registry.clean_orphans"
        ],
        "start": [
            "env.launch"
        ],
        "init": [],
        "update": [
            "update.run"
        ],
        "status": [
            "status.run"
        ],
        "uninstall": [
            "uninstall.run"
        ],
        "migrate-layout": [
            "migration.run_layout_migration"
        ]
    }
}