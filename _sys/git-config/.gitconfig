# ================================================================
# git_config/.gitconfig  -  Portable Git settings
#
# start.bat selects this file through the GIT_CONFIG_GLOBAL environment variable.
# Applies only when portable Git (git\cmd\git.exe) is available.
#
# delta integration: start.bat sets GIT_PAGER=delta when delta.exe is detected
#             This file defines only delta UI options
# ================================================================

[core]
    # Prevent automatic line-ending conversion on Windows (avoid confusion during team collaboration)
    autocrlf = input
    safecrlf = warn

[init]
    defaultBranch = main

[pull]
    rebase = false

# ── delta options (effective when the tools\delta\ folder exists) ─────────
[delta]
    navigate     = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula

[diff]
    colorMoved = default

[merge]
    conflictstyle = diff3

# ── Frequently used aliases ──────────────────────────────────────────────
# ── Authentication (override system gitconfig to handle drive letter changes) ────
[credential]
    helper =
    helper = manager

[alias]
    # Commit log as a graph
    lg  = log --oneline --graph --decorate --all
    # Concise status
    st  = status -sb
    # Show the latest commit
    last = log -1 HEAD --stat
    # Unstage changes
    unstage = reset HEAD --
