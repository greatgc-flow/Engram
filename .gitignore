# Engram: Minimal Core Git Ignore (MECE)
# =================================================================
# 1. User Workspaces, Data, and Archives
# =================================================================
/workspace/
/_workspace/
/_archive/
/dist/
WORKLOG.md
# =================================================================
# 2. Ephemeral State & IPC (Inter-Process Communication)
# =================================================================
.ai/
_state/
# =================================================================
# 3. Downloaded Environments, Binaries, and Runtimes
# =================================================================
# env/ is bootstrapped via install.bat ??not tracked
# tools/ are bootstrapped via install.bat / provisioner ??not tracked
# =================================================================
# 4. Local Configurations & Device-Specific State
# =================================================================
# Do not track drive letters, context menu states, or local overrides
**/local.config.bat
.env
# =================================================================
# 5. Session plans and dynamic documentation (not tracked)
# =================================================================
/plans/
# =================================================================
# 6. Test Environments & Results
# =================================================================
.pytest_cache/
setup_test_env.py
# =================================================================
# 7. Root-level session/debug log dumps
# =================================================================
/agy_log*.txt
/out.txt
/err.txt
/integration_log.txt
/integration_log*.txt
# Accidental 0-byte peer temp files (e.g., /See created by cx during ask session)
/See
/Remains
# Python temporary-directory write probes contain exactly "blat". These files
# are detected by validation and should be removed, not silently ignored.
# Pytest temp dirs scattered to root
/.pytest-basetemp/
/.pytest-local/
/.pytest-tmp/
/.pytest-work/
/pytest_local/
# =================================================================
# 8. System, Editor, & Cache Garbage
# =================================================================
# Personal brain-dump / credential notes ??never commit
/MemoryDump.md
/Garbage/
/tmp/
.DS_Store
Thumbs.db
.vscode/
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.tmp
*.bak
# Test sandbox run-logs (E2 ??were tracked + dirtied every test run)
# 2026-08-09 cleanup: peerhub is its own standalone git repository (not a
# submodule).
peerhub/
.peerhub/
# Dotdir consolidation (ratified 2026-09-09): live personal/durable
# settings root for Engram-managed AI CLIs (Claude Code/Codex/Antigravity/
# git/gh) once redirected there -- contains real credentials and caches,
# never bundled into a git repo or a release archive.
.engram/
# Isolated install/verification test clones (not product source)
/output/
_sys/runtimes.json
_sys/tool-catalog.v1.json
_sys/core/release-manifest.json

# Runtime-generated data, mutable telemetry, and personal backups (Finding H-2)
_sys/data/backups/
_sys/data/operational_errors.jsonl
_sys/data/*.jsonl
_sys/data/state/
_sys/data/logs/
_sys/data/setup-files/
_sys/data/temp/

# hub.py --project-dir ask-temp scratch (peer-subprocess TEMP/TMP when this
# repo is used as an ask target outside hub.py's own default project root)
hub_ask_temp/
